// These tests need a MySQL or MariaDB server; without ADM_TEST_MYSQL they
// pass without running. See README.md for the server they expect.
partial module adm.database.mysql {
	use (
		std.testing
		std.data.db
		std.math
		std.reflection
		std.time
	)

	// The server's address as `host:port`, for a database `shop` owned by
	// user `app` with password `secret`, and `root` with password `rootpw`.
	@env("ADM_TEST_MYSQL")
	internal const testServer string

	struct Customer {
		id int
		name string
		@db.column("mail")
		email ?string
		balance math.Decimal
		active bool
		joined time.DateTime
		photo byte[]
	}

	def serverURL(options string = "sslmode=disable") string {
		return "mysql://app:secret@{testServer}/shop?{options}"
	}

	def kindOfFailure(err error) db.ErrorKind {
		return err.kind when err is db.DbError
		return db.ErrorKind.Other
	}

	def numberOfFailure(err error) int {
		return err.native when err is db.DbError
		return 0
	}

	// A connection with an empty `customers` table of its own (a temporary
	// table lives and dies with the session).
	def customers() !db.Connection {
		let conn = try db.connect(serverURL())
		try conn.exec("CREATE TEMPORARY TABLE customers (id int PRIMARY KEY, name varchar(64) NOT NULL UNIQUE, mail varchar(128), balance decimal(12,2) NOT NULL DEFAULT 0, active boolean NOT NULL DEFAULT true, joined datetime(6) NOT NULL DEFAULT '2026-01-01 00:00:00', photo blob) CHARACTER SET utf8mb4")
		return conn
	}

	def stopSoon(conn Connection) !none {
		time.sleep(300ms)
		return conn.interrupt()
	}

	check "Connect" {
		@test()
		def TestSchemesAreRegistered() !none {
			assert db.drivers().includes("mysql")
			assert db.drivers().includes("mariadb")
		}

		@test()
		def TestLoginMethods() !none {
			return none when testServer == ""
			let conn = try open(serverURL())
			try conn.ping()
			assert conn.serverVersion().len() > 0
			assert conn.threadId() > 0
			let maria = conn.serverVersion().contains("MariaDB")
			try conn.close()
			try conn.close()

			let root = try db.connect("mysql://root:rootpw@{testServer}/shop?sslmode=require")
			try root.exec("DROP USER IF EXISTS 'native'@'%'")
			try root.exec("CREATE USER 'native'@'%' IDENTIFIED WITH mysql_native_password BY 'nativepw'") unless maria
			try root.exec("CREATE USER 'native'@'%' IDENTIFIED VIA mysql_native_password USING PASSWORD('nativepw')") when maria
			try root.exec("GRANT ALL ON shop.* TO 'native'@'%'")
			let native = try db.connect("mysql://native:nativepw@{testServer}/shop?sslmode=disable")
			try native.ping()
			try native.close()

			try root.exec("DROP USER IF EXISTS 'empty'@'%'")
			try root.exec("CREATE USER 'empty'@'%' IDENTIFIED BY ''")
			let empty0 = try db.connect("mysql://empty@{testServer}/?sslmode=disable")
			try empty0.ping()
			try empty0.close()

			if !maria {
				// A user the server has not seen yet: without TLS the
				// password goes under the server's RSA key.
				try root.exec("DROP USER IF EXISTS 'fresh'@'%'")
				try root.exec("CREATE USER 'fresh'@'%' IDENTIFIED WITH caching_sha2_password BY 'freshpw'")
				try root.exec("GRANT ALL ON shop.* TO 'fresh'@'%'")
				let fresh = try db.connect("mysql://fresh:freshpw@{testServer}/shop?sslmode=disable")
				try fresh.ping()
				try fresh.close()
				// Now the server has the hash cached: the short exchange.
				let cached = try db.connect("mysql://fresh:freshpw@{testServer}/shop?sslmode=disable")
				try cached.ping()
				try cached.close()

				try root.exec("DROP USER IF EXISTS 'fresh'@'%'")
				try root.exec("CREATE USER 'fresh'@'%' IDENTIFIED WITH caching_sha2_password BY 'freshpw'")
				let overTls = try db.connect("mysql://fresh:freshpw@{testServer}/?sslmode=require")
				try overTls.ping()
				try overTls.close()

				try root.exec("DROP USER IF EXISTS 'sha'@'%'")
				try root.exec("CREATE USER 'sha'@'%' IDENTIFIED WITH sha256_password BY 'shapw'")
				let sha = try db.connect("mysql://sha:shapw@{testServer}/?sslmode=disable")
				try sha.ping()
				try sha.close()
				let shaTls = try db.connect("mysql://sha:shapw@{testServer}/?sslmode=require")
				try shaTls.ping()
				try shaTls.close()
				try root.exec("DROP USER IF EXISTS 'sha'@'%'")
				try root.exec("DROP USER IF EXISTS 'fresh'@'%'")
			}
			try root.exec("DROP USER IF EXISTS 'native'@'%'")
			try root.exec("DROP USER IF EXISTS 'empty'@'%'")
			try root.close()
		}

		@test()
		def TestRefusals() !none {
			return none when testServer == ""
			let fallback = try db.connect(serverURL())

			let kind = db.ErrorKind.Other
			let number = 0
			db.connect("mysql://app:wrong@{testServer}/shop?sslmode=disable") onerror (err error) {
				kind = kindOfFailure(err)
				number = numberOfFailure(err)
				recover fallback
			}
			assert kind == db.ErrorKind.Denied
			assert number == 1045

			kind = db.ErrorKind.Other
			db.connect("mysql://app:secret@{testServer}/nosuchdb?sslmode=disable") onerror (err error) {
				kind = kindOfFailure(err)
				recover fallback
			}
			assert kind == db.ErrorKind.Denied

			kind = db.ErrorKind.Other
			db.connect("mysql://app:secret@127.0.0.1:1/shop?connect_timeout=2") onerror (err error) {
				kind = kindOfFailure(err)
				recover fallback
			}
			assert kind == db.ErrorKind.Connection

			let message = ""
			db.connect(serverURL("nonsense=1")) onerror (err error) {
				message = err.message
				recover fallback
			}
			assert message == "mysql: unknown option 'nonsense'"
			try fallback.close()
		}

		@test()
		def TestTls() !none {
			return none when testServer == ""
			let conn = try db.connect(serverURL("sslmode=require"))
			let rows = try conn.query("SHOW SESSION STATUS LIKE 'Ssl_cipher'")
			assert try rows.next()
			let cipher = try rows.string(1)
			assert cipher.len() > 0
			try rows.close()
			try conn.close()

			let plain = try db.connect(serverURL("sslmode=disable"))
			let none0 = try plain.query("SHOW SESSION STATUS LIKE 'Ssl_cipher'")
			assert try none0.next()
			assert try none0.string(1) == ""
			try none0.close()

			// The test server's certificate is signed by no known authority.
			let kind = db.ErrorKind.Other
			db.connect(serverURL("sslmode=verify-full")) onerror (err error) {
				kind = kindOfFailure(err)
				recover plain
			}
			assert kind == db.ErrorKind.Connection
			try plain.close()
		}
	}

	check "Statements" {
		@test()
		def TestTypesRoundTripInBothProtocols() !none {
			return none when testServer == ""
			let conn = try db.connect(serverURL())
			try conn.exec("CREATE TEMPORARY TABLE kinds (i tinyint, s smallint, m mediumint, n int, b bigint, u bigint unsigned, f float, d double, dec1 decimal(10,2), t varchar(32), bin1 varbinary(8), big1 blob, dt datetime(6), ts timestamp(3) NULL, da date, ti time(3), y year, j json, e enum('a','b'), bi bit(8), nul int) CHARACTER SET utf8mb4")
			let blob byte[] = [0, 1, 2, 255]
			let at = try time.parse("2026-10-06T12:30:00.25Z")
			let res = try conn.exec("INSERT INTO kinds VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)", -7, -300, 70000, -2000000000, 9223372036854775807, "18446744073709551615", 1.5, 2.5, try math.parseDecimal("1234.50"), "Żółw 🐢", blob, blob, at, new time.DateTime(2026, 10, 6, 12, 30, 15), new time.Date(2026, 10, 6), new time.TimeOfDay(12, 30, 15), 2026, "\{\"a\": 1\}", "b", 5, none)
			assert res.affected == 1

			// With an argument the rows come in the binary protocol,
			// without in the text one; both must read alike.
			for let pass = 0; pass < 2; pass++ {
				let rows = try conn.query("SELECT * FROM kinds")
				if pass == 0 {
					try rows.close()
					rows = try conn.query("SELECT * FROM kinds WHERE i = ?", -7)
				}
				let cols = rows.columns()
				assert cols.len() == 21
				assert cols[5].typeName == "bigint unsigned"
				assert cols[9].typeName == "varchar"
				assert cols[11].typeName == "blob"
				assert try rows.next()
				assert try rows.int(0) == -7
				assert try rows.int(1) == -300
				assert try rows.int(2) == 70000
				assert try rows.int(3) == -2000000000
				assert try rows.int(4) == 9223372036854775807
				assert try rows.string(5) == "18446744073709551615"
				assert reflection.typeName(try rows.value(5)) == "builtin.bigint"
				assert try rows.float(6) == 1.5
				assert try rows.float(7) == 2.5
				assert try rows.float(0) == -7.0
				assert try rows.string(8) == "1234.50"
				assert reflection.typeName(try rows.value(8)) == "std.math.Decimal"
				assert try rows.string(9) == "Żółw 🐢"
				let small = try rows.bytes(10)
				assert small.hex() == "000102FF"
				let large = try rows.bytes(11)
				assert large.hex() == "000102FF"
				assert reflection.typeName(try rows.value(11)) == "byte[]"
				assert try rows.string(12) == "2026-10-06 12:30:00.250000"
				assert reflection.typeName(try rows.value(12)) == "std.time.DateTime"
				assert try rows.string(13) == "2026-10-06 12:30:15.000"
				assert try rows.string(14) == "2026-10-06"
				assert reflection.typeName(try rows.value(14)) == "std.time.Date"
				assert try rows.string(15) == "12:30:15.000"
				assert reflection.typeName(try rows.value(15)) == "std.time.TimeOfDay"
				assert try rows.int(16) == 2026
				assert try rows.string(18) == "b"
				assert try rows.bool(0)
				assert rows.isNull(20)
				assert (try rows.value(20)) is none

				let kind = db.ErrorKind.Other
				rows.int(9) onerror (err error) {
					kind = kindOfFailure(err)
					recover 0
				}
				assert kind == db.ErrorKind.Type
				kind = db.ErrorKind.Other
				rows.string(20) onerror (err error) {
					kind = kindOfFailure(err)
					recover ""
				}
				assert kind == db.ErrorKind.Type
				assert !(try rows.next())
			}
			try conn.close()
		}

		@test()
		def TestExecCountsAndSeveralStatements() !none {
			return none when testServer == ""
			let conn = try customers()
			let res = try conn.exec("INSERT INTO customers (id, name) VALUES (?, ?), (?, ?)", 1, "Ana", 2, "Bob")
			assert res.affected == 2
			res = try conn.exec("UPDATE customers SET active = false WHERE id > ?", 0)
			assert res.affected == 2
			res = try conn.exec("UPDATE customers SET active = false")
			assert res.affected == 0

			// Several statements in one text are refused unless asked for.
			let kind = db.ErrorKind.Other
			conn.exec("DELETE FROM customers WHERE id = 1; DELETE FROM customers WHERE id = 2") onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Syntax
			try conn.close()

			let multi = try db.connect(serverURL("sslmode=disable&multi_statements=true&found_rows=true"))
			try multi.exec("CREATE TEMPORARY TABLE pairs (id int AUTO_INCREMENT PRIMARY KEY, v int)")
			res = try multi.exec("INSERT INTO pairs (v) VALUES (1), (2); INSERT INTO pairs (v) VALUES (3); SELECT * FROM pairs; UPDATE pairs SET v = 3 WHERE id = 3")
			assert res.affected == 4
			assert res.lastInsertId == 3
			let rows = try multi.query("SELECT v FROM pairs ORDER BY id; SELECT 99")
			assert try rows.next()
			assert try rows.int(0) == 1
			try rows.close()
			try multi.ping()
			try multi.close()
		}

		@test()
		def TestErrors() !none {
			return none when testServer == ""
			let conn = try customers()
			try conn.exec("INSERT INTO customers (id, name) VALUES (1, 'Ana')")

			let kind = db.ErrorKind.Other
			let number = 0
			conn.exec("INSERT INTO customers (id, name) VALUES (?, ?)", 2, "Ana") onerror (err error) {
				kind = kindOfFailure(err)
				number = numberOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Constraint
			assert number == 1062

			kind = db.ErrorKind.Other
			conn.exec("SELEC 1") onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Syntax

			kind = db.ErrorKind.Other
			conn.query("SELECT * FROM nowhere WHERE a = ?", 1) onerror (err error) {
				kind = kindOfFailure(err)
				number = numberOfFailure(err)
				recover try conn.query("SELECT 1")
			}
			assert kind == db.ErrorKind.Syntax
			assert number == 1146

			kind = db.ErrorKind.Other
			conn.exec("SELECT ?, ?", 1) onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Type

			kind = db.ErrorKind.Other
			conn.exec("SELECT ?", conn) onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Type

			// The session is still usable after each failure.
			try conn.ping()
			try conn.close()
			kind = db.ErrorKind.Other
			conn.exec("SELECT 1") onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Closed
		}

		@test()
		def TestLargeResultsAndValues() !none {
			return none when testServer == ""
			let conn = try db.connect(serverURL())
			try conn.exec("DROP TABLE IF EXISTS numbers")
			try conn.exec("CREATE TABLE numbers (n int PRIMARY KEY, pad varchar(40))")
			let fill = try conn.prepare("INSERT INTO numbers VALUES (?, ?)")
			try conn.exec("START TRANSACTION")
			for let i = 1; i <= 1000; i++ {
				try fill.exec(i, "x".repeat(40))
			}
			try conn.exec("COMMIT")
			try fill.close()
			let rows = try conn.query("SELECT a.n + (b.n - 1) * 1000, a.pad FROM numbers a, numbers b WHERE b.n <= ?", 20)
			let count = 0
			let sum = 0
			for try rows.next() {
				count++
				sum += try rows.int(0)
			}
			assert count == 20000
			assert sum == 200010000

			let big = try conn.query("SELECT repeat('ab', ?)", 150000)
			assert try big.next()
			let text = try big.string(0)
			assert text.len() == 300000
			assert text.endsWith("abab")
			try big.close()

			// A value longer than one packet carries (16 MiB).
			let limit = try conn.query("SELECT @@max_allowed_packet")
			assert try limit.next()
			let allowed = try limit.int(0)
			try limit.close()
			if allowed > 40000000 {
				let huge = try conn.query("SELECT length(?), ?", "y".repeat(17000000), 5)
				assert try huge.next()
				assert try huge.int(0) == 17000000
				assert try huge.int(1) == 5
				try huge.close()
				let back = try conn.query("SELECT repeat('z', 17000000), 7")
				assert try back.next()
				let long0 = try back.string(0)
				assert long0.len() == 17000000
				assert try back.int(1) == 7
				try back.close()
			}

			// Rows left unread end when another statement runs.
			let open0 = try conn.query("SELECT n FROM numbers")
			assert try open0.next()
			try conn.ping()
			let kind = db.ErrorKind.Other
			open0.next() onerror (err error) {
				kind = kindOfFailure(err)
				recover false
			}
			assert kind == db.ErrorKind.Closed
			try conn.exec("DROP TABLE numbers")
			try conn.close()
		}

		@test()
		def TestPreparedStatements() !none {
			return none when testServer == ""
			let conn = try customers()
			let insert = try conn.prepare("INSERT INTO customers (id, name, balance) VALUES (?, ?, ?)")
			for let i = 1; i <= 50; i++ {
				let res = try insert.exec(i, "c{i}", i * 10)
				assert res.affected == 1
			}
			try insert.close()
			try insert.close()

			let find = try conn.prepare("SELECT name FROM customers WHERE balance >= :low AND balance < :low + 20 ORDER BY id")
			let named = new map<string, any>()
			named.set("low", 100)
			let rows = try find.query(named)
			assert try rows.next()
			assert try rows.string(0) == "c10"
			assert try rows.next()
			assert try rows.string(0) == "c11"
			assert !(try rows.next())
			let again = try find.query(490, 490)
			assert try again.next()
			assert try again.string(0) == "c49"
			try again.close()
			try find.close()

			let kind = db.ErrorKind.Other
			find.exec(1, 1) onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Closed

			kind = db.ErrorKind.Other
			conn.prepare("SELECT * FROM nowhere") onerror (err error) {
				kind = kindOfFailure(err)
				recover find
			}
			assert kind == db.ErrorKind.Syntax
			try conn.close()
		}
	}

	check "Transactions" {
		@test()
		def TestCommitRollbackAndReadOnly() !none {
			return none when testServer == ""
			let conn = try db.connect(serverURL())
			try conn.exec("DROP TABLE IF EXISTS tx_probe")
			try conn.exec("CREATE TABLE tx_probe (id int PRIMARY KEY, name varchar(32)) ENGINE=InnoDB")
			let tx = try conn.beginTx()
			try tx.exec("INSERT INTO tx_probe VALUES (?, ?)", 1, "kept")
			try tx.commitTx()
			let kind = db.ErrorKind.Other
			tx.exec("SELECT 1") onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Closed

			let undo = try conn.beginTx(db.Isolation.Serializable)
			try undo.exec("INSERT INTO tx_probe VALUES (?, ?)", 2, "dropped")
			let message = ""
			conn.beginTx() onerror (err error) {
				message = err.message
				recover undo
			}
			assert message == "mysql: a transaction is already open on this connection"
			try undo.rollbackTx()
			try undo.rollbackTx()

			let reader = try conn.beginTx(db.Isolation.RepeatableRead, true)
			kind = db.ErrorKind.Other
			reader.exec("INSERT INTO tx_probe VALUES (9, 'no')") onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.Denied
			try reader.rollbackTx()

			let rows = try conn.query("SELECT name FROM tx_probe ORDER BY id")
			assert try rows.next()
			assert try rows.string(0) == "kept"
			assert !(try rows.next())
			try conn.exec("DROP TABLE tx_probe")
			try conn.close()
		}
	}

	check "Objects" {
		@test()
		def TestValuesInsertAndReadBack() !none {
			return none when testServer == ""
			let conn = try customers()
			let joined = new time.DateTime(2026, 10, 6, 12, 30, 0)
			let a = Customer{id: 7, name: "Ana", email: "ana@example.com", balance: try math.parseDecimal("12.50"), active: true, joined: joined, photo: [1, 2, 3]}
			try conn.exec("INSERT INTO customers (id, name, mail, balance, active, joined, photo) VALUES (:id, :name, :mail, :balance, :active, :joined, :photo)", db.values(a))
			let b = Customer{id: 8, name: "Bob", email: none, balance: new math.Decimal(0), active: false, joined: joined, photo: byte[]}
			try conn.exec("INSERT INTO customers (id, name, mail, balance, active, joined, photo) VALUES (:id, :name, :mail, :balance, :active, :joined, :photo)", db.values(b))

			let all = try db.readAll<Customer>(try conn.query("SELECT * FROM customers ORDER BY id"))
			assert all.len() == 2
			assert all[0].id == 7
			assert all[0].name == "Ana"
			assert all[0].balance.str() == "12.50"
			assert all[0].active
			assert all[0].joined.str() == joined.str()
			assert all[0].photo.hex() == "010203"
			let mail = all[0].email
			fail "expected an address" when mail is none
			assert mail == "ana@example.com"
			assert all[1].email is none
			assert !all[1].active
			assert all[1].photo.len() == 0
			try conn.close()
		}
	}

	check "Interrupting" {
		@test()
		def TestInterruptStopsTheStatement() !none {
			return none when testServer == ""
			let conn = try open(serverURL())
			let stopper = async stopSoon(conn)
			let started = time.now()
			let kind = db.ErrorKind.Other
			conn.exec("SELECT count(*) FROM information_schema.columns a, information_schema.columns b, information_schema.columns c") onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.TimedOut
			assert time.since(started) < 20s
			try await stopper
			try conn.ping()
			try conn.close()
		}

		@test()
		def TestReadTimeoutEndsTheSession() !none {
			return none when testServer == ""
			let conn = try db.connect(serverURL("sslmode=disable&read_timeout=1"))
			let kind = db.ErrorKind.Other
			conn.exec("SELECT SLEEP(4)") onerror (err error) {
				kind = kindOfFailure(err)
				recover db.Result{affected: 0, lastInsertId: 0}
			}
			assert kind == db.ErrorKind.TimedOut
			kind = db.ErrorKind.Other
			conn.ping() onerror (err error) {
				kind = kindOfFailure(err)
				recover none
			}
			assert kind == db.ErrorKind.Closed
		}
	}
}
