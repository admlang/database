// MessagePack for records of plain fields: just the formats they need,
// written into and read from a buffer in place.
internal partial module adm.database.store.engine {
	use std.bytes

	def packWord(out byte[], value uint64, size int) {
		for let shift = (size - 1) * 8; shift >= 0; shift -= 8 {
			out.push(byte((value >> shift) & 0xFF))
		}
	}

	// A non-negative integer in its smallest format.
	def packUint(out byte[], value uint64) {
		if value < 0x80 {
			out.push(byte(value))
		} else if value <= 0xFF {
			out.push(byte(0xCC))
			out.push(byte(value))
		} else if value <= 0xFFFF {
			out.push(byte(0xCD))
			packWord(out, value, 2)
		} else if value <= 0xFFFFFFFF {
			out.push(byte(0xCE))
			packWord(out, value, 4)
		} else {
			out.push(byte(0xCF))
			packWord(out, value, 8)
		}
	}

	// An integer in its smallest format.
	def packInt(out byte[], value int) {
		if value >= 0 {
			packUint(out, uint64(value))
			return
		}
		let bits = uint64(value)
		if value >= -32 {
			out.push(byte(bits & 0xFF))
		} else if value >= -0x80 {
			out.push(byte(0xD0))
			out.push(byte(bits & 0xFF))
		} else if value >= -0x8000 {
			out.push(byte(0xD1))
			packWord(out, bits, 2)
		} else if value >= -0x80000000 {
			out.push(byte(0xD2))
			packWord(out, bits, 4)
		} else {
			out.push(byte(0xD3))
			packWord(out, bits, 8)
		}
	}

	def packFloat(out byte[], value float, single bool) {
		if single {
			out.push(byte(0xCA))
			out.push(...float32(value).bytes(bytes.Endian.Big))
			return
		}
		out.push(byte(0xCB))
		out.push(...float64(value).bytes(bytes.Endian.Big))
	}

	def packText(out byte[], data byte[]) {
		let n = data.len()
		if n < 32 {
			out.push(byte(0xA0 | n))
		} else if n <= 0xFF {
			out.push(byte(0xD9))
			out.push(byte(n))
		} else if n <= 0xFFFF {
			out.push(byte(0xDA))
			packWord(out, uint64(n), 2)
		} else {
			out.push(byte(0xDB))
			packWord(out, uint64(n), 4)
		}
		out.push(...data)
	}

	def packBytes(out byte[], data byte[]) {
		let n = data.len()
		if n <= 0xFF {
			out.push(byte(0xC4))
			out.push(byte(n))
		} else if n <= 0xFFFF {
			out.push(byte(0xC5))
			packWord(out, uint64(n), 2)
		} else {
			out.push(byte(0xC6))
			packWord(out, uint64(n), 4)
		}
		out.push(...data)
	}

	def packMapHead(out byte[], count int) {
		if count < 16 {
			out.push(byte(0x80 | count))
		} else if count <= 0xFFFF {
			out.push(byte(0xDE))
			packWord(out, uint64(count), 2)
		} else {
			out.push(byte(0xDF))
			packWord(out, uint64(count), 4)
		}
	}

	// An instant, nanoseconds since 1970, as the timestamp extension in
	// the smallest of its three forms.
	def packTime(out byte[], ns int) {
		let sec = ns / 1000000000
		let nsec = ns % 1000000000
		if nsec < 0 {
			sec--
			nsec += 1000000000
		}
		if sec >= 0 && sec < 0x400000000 {
			if nsec == 0 && sec <= 0xFFFFFFFF {
				out.push(byte(0xD6))
				out.push(byte(0xFF))
				packWord(out, uint64(sec), 4)
				return
			}
			out.push(byte(0xD7))
			out.push(byte(0xFF))
			packWord(out, (uint64(nsec) << 34) | uint64(sec), 8)
			return
		}
		out.push(byte(0xC7))
		out.push(byte(12))
		out.push(byte(0xFF))
		packWord(out, uint64(nsec), 4)
		packWord(out, uint64(sec), 8)
	}

	// Unpacker reads MessagePack objects from a buffer. A read that finds
	// another object than it was asked for returns false and stays where it
	// was; `data` running out sets `short` as well.
	type Unpacker {
		data    byte[]
		at      int
		short   bool
		// What the last read found: a number, or where a run of bytes is.
		whole   int
		natural uint64
		real    float
		flag    bool
		from    int
		size    int

		def new(data byte[]) {
			self.data = data
		}

		// The next byte without moving; -1 at the end.
		def peek() int {
			return at < data.len() ?? (int(data[at]), -1)
		}

		// Whether `count` bytes follow the one at `at`.
		def follows(count int) bool {
			return true when at + 1 + count <= data.len()
			short = true
			return false
		}

		// The big-endian number in the `size` bytes at `pos`.
		def word(pos int, size int) uint64 {
			let value uint64 = 0
			for let i = 0; i < size; i++ {
				value = (value << 8) | uint64(data[pos + i])
			}
			return value
		}

		def readNil() bool {
			return false unless peek() == 0xC0
			at++
			return true
		}

		// A map's head; its entry count goes to `size`.
		def readMapHead() bool {
			let lead = peek()
			if lead >= 0x80 && lead <= 0x8F {
				size = lead & 0x0F
				at++
				return true
			}
			return false unless lead := 0xDE || 0xDF
			let width = lead == 0xDE ?? (2, 4)
			return false unless follows(width)
			size = int(word(at + 1, width))
			at += 1 + width
			return true
		}

		def readBool() bool {
			let lead = peek()
			return false unless lead := 0xC2 || 0xC3
			flag = lead == 0xC3
			at++
			return true
		}

		// An integer that fits an int goes to `whole`.
		def readInt() bool {
			let lead = peek()
			return false when lead < 0
			if lead < 0x80 {
				whole = lead
				at++
				return true
			}
			if lead >= 0xE0 {
				whole = lead - 256
				at++
				return true
			}
			match lead {
				case 0xCC, 0xCD, 0xCE, 0xCF:
					let width = 1 << (lead - 0xCC)
					return false unless follows(width)
					let value = word(at + 1, width)
					return false when value > 0x7FFFFFFFFFFFFFFF
					whole = int(value)
					at += 1 + width
					return true
				case 0xD0, 0xD1, 0xD2, 0xD3:
					let width = 1 << (lead - 0xD0)
					return false unless follows(width)
					let value = int(word(at + 1, width))
					// Extends the sign of a number narrower than an int.
					let bits = width * 8
					value -= 1 << bits when bits < 64 && (value & (1 << (bits - 1))) != 0
					whole = value
					at += 1 + width
					return true
				default:
					return false
			}
		}

		// A non-negative integer goes to `natural`.
		def readUint() bool {
			let lead = peek()
			return false when lead < 0
			if lead < 0x80 {
				natural = uint64(lead)
				at++
				return true
			}
			return false unless lead >= 0xCC && lead <= 0xCF
			let width = 1 << (lead - 0xCC)
			return false unless follows(width)
			natural = word(at + 1, width)
			at += 1 + width
			return true
		}

		// A float of either width goes to `real`.
		def readFloat() bool {
			let lead = peek()
			if lead == 0xCA {
				return false unless follows(4)
				real = float(float32(0).fromBytes(data[at + 1:at + 5], bytes.Endian.Big))
				at += 5
				return true
			}
			return false unless lead == 0xCB
			return false unless follows(8)
			real = float(float64(0).fromBytes(data[at + 1:at + 9], bytes.Endian.Big))
			at += 9
			return true
		}

		// Takes a run of `count` bytes that starts `head` bytes on.
		def run(head int, count int) bool {
			if at + head + count > data.len() {
				short = true
				return false
			}
			from = at + head
			size = count
			at = from + count
			return true
		}

		// A str: its bytes are `size` bytes at `from`.
		def readText() bool {
			let lead = peek()
			return run(1, lead & 0x1F) when lead >= 0xA0 && lead <= 0xBF
			return false unless lead >= 0xD9 && lead <= 0xDB
			let width = 1 << (lead - 0xD9)
			return false unless follows(width)
			return run(1 + width, int(word(at + 1, width)))
		}

		// A bin: its bytes are `size` bytes at `from`.
		def readBytes() bool {
			let lead = peek()
			return false unless lead >= 0xC4 && lead <= 0xC6
			let width = 1 << (lead - 0xC4)
			return false unless follows(width)
			return run(1 + width, int(word(at + 1, width)))
		}

		// A timestamp that fits an int of nanoseconds goes to `whole`.
		def readTime() bool {
			let lead = peek()
			if lead == 0xD6 {
				return false unless follows(5) && data[at + 1] == 0xFF
				whole = int(word(at + 2, 4)) * 1000000000
				at += 6
				return true
			}
			if lead == 0xD7 {
				return false unless follows(9) && data[at + 1] == 0xFF
				let both = word(at + 2, 8)
				let nsec = int(both >> 34)
				return false when nsec > 999999999
				whole = int(both & 0x3FFFFFFFF) * 1000000000 + nsec
				at += 10
				return true
			}
			return false unless lead == 0xC7
			return false unless follows(14) && data[at + 1] == 12 && data[at + 2] == 0xFF
			let nsec = int(word(at + 3, 4))
			let sec = int(word(at + 7, 8))
			// What an int of nanoseconds holds: about 1677 to 2262.
			return false when nsec > 999999999 || sec < -9223372037 || sec > 9223372036
			return false when (sec == -9223372037 && nsec < 145224192) || (sec == 9223372036 && nsec > 854775807)
			// The last second before the range is reached from the one
			// after it, which is in it.
			whole = sec < 0 ?? ((sec + 1) * 1000000000 + (nsec - 1000000000), sec * 1000000000 + nsec)
			at += 15
			return true
		}

		// Moves past one object of any kind. False when the data ends
		// inside it or it nests deeper than `depth` levels.
		def skip(depth int = 64) bool {
			let lead = peek()
			if lead < 0 || depth < 0 {
				short = true
				return false
			}
			let plain = 0
			let items = 0
			if lead < 0x80 || lead >= 0xE0 || lead == 0xC0 || lead == 0xC2 || lead == 0xC3 {
				plain = 1
			} else if lead <= 0x8F {
				at++
				items = (lead & 0x0F) * 2
			} else if lead <= 0x9F {
				at++
				items = lead & 0x0F
			} else if lead <= 0xBF {
				plain = 1 + (lead & 0x1F)
			} else {
				match lead {
					case 0xC4, 0xC5, 0xC6, 0xD9, 0xDA, 0xDB:
						let width = 1 << (lead - (lead < 0xD0 ?? (0xC4, 0xD9)))
						return false unless follows(width)
						plain = 1 + width + int(word(at + 1, width))
					case 0xC7, 0xC8, 0xC9:
						let width = 1 << (lead - 0xC7)
						return false unless follows(width)
						plain = 2 + width + int(word(at + 1, width))
					case 0xCA, 0xCE, 0xD2:
						plain = 5
					case 0xCB, 0xCF, 0xD3:
						plain = 9
					case 0xCC, 0xD0:
						plain = 2
					case 0xCD, 0xD1:
						plain = 3
					case 0xD4, 0xD5, 0xD6, 0xD7, 0xD8:
						plain = 2 + (1 << (lead - 0xD4))
					case 0xDC, 0xDD, 0xDE, 0xDF:
						let width = (lead == 0xDC || lead == 0xDE) ?? (2, 4)
						return false unless follows(width)
						items = int(word(at + 1, width)) * (lead >= 0xDE ?? (2, 1))
						at += 1 + width
					default:
						return false
				}
			}
			if plain > 0 {
				if at + plain > data.len() {
					short = true
					return false
				}
				at += plain
				return true
			}
			for let i = 0; i < items; i++ {
				return false unless skip(depth - 1)
			}
			return true
		}
	}
}
